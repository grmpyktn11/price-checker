# the app always searches the real retailers. ANTHROPIC_API_KEY is required: without it the
# backend refuses to start, because product filtering is a model call with no offline path.
ANTHROPIC_API_KEY=
PLAYWRIGHT_HEADLESS=1
# server-side: Places (New) text search, used to find the nearest Target/Best Buy for the
# distance score. blank leaves that score neutral for every retailer
GOOGLE_PLACES_API_KEY=
# read by Settings.tsx for address autocomplete, so vite bakes it into the browser bundle.
# use a separate HTTP-referrer-restricted key, never the server-side one above
VITE_GOOGLE_PLACES_API_KEY=
# reddit needs no key: it is the public search feed
# youtube is only searched when the research call cannot separate the top two products
YOUTUBE_API_KEY=
RESEND_API_KEY=
USER_EMAIL=
DATABASE_URL=sqlite:///./app.db

# ngrok, only for reaching the app from a phone away from home. the CLI reads this variable
# itself, so scripts/tunnel.ps1 just loads .env and runs it - nothing in the app touches it.
# get one at dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=
