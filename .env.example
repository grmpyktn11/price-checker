# Leave keys blank to run against the saved fixtures in tests/fixtures.
# LIVE_SCRAPE=1 opts the scrapers into hitting the real sites.
LIVE_SCRAPE=
PLAYWRIGHT_HEADLESS=1
ANTHROPIC_API_KEY=
GOOGLE_PLACES_API_KEY=
# read by Settings.tsx for address autocomplete, so vite bakes it into the browser bundle.
# use a separate HTTP-referrer-restricted key, never the server-side one above
VITE_GOOGLE_PLACES_API_KEY=
# reddit needs no key: it is the public search feed, gated by LIVE_SCRAPE like the scrapers
YOUTUBE_API_KEY=
RESEND_API_KEY=
USER_EMAIL=
DATABASE_URL=sqlite:///./app.db
